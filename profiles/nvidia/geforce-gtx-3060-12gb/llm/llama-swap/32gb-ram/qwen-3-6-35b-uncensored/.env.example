# llama-swap image bundling llama.cpp built for NVIDIA CUDA.
IMAGE=ghcr.io/mostlygeek/llama-swap:cuda
# Host directory mounted as /models in the container.
MODELS_HOST_DIR=./models
# One subdirectory per model inside /models.
MODEL_DIR=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive
MODEL_FILE=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf

# (File was top-level in /models in the original compose; adapted to the 
# one-subdirectory-per-model convention.)
