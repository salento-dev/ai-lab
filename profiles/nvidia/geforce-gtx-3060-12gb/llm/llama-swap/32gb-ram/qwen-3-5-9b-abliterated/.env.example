# llama-swap image bundling llama.cpp built for NVIDIA CUDA.
IMAGE=ghcr.io/mostlygeek/llama-swap:cuda
# Host directory mounted as /models in the container.
MODELS_HOST_DIR=./models
# One subdirectory per model inside /models.
MODEL_DIR=qwen3.5-9b-null-space-abliterated
MODEL_FILE=qwen3.5-9b-null-space-abliterated-q8_0.gguf
