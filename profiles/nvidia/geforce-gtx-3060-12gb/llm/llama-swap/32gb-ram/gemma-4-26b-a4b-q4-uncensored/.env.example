# llama-swap image bundling llama.cpp built for NVIDIA CUDA.
IMAGE=ghcr.io/mostlygeek/llama-swap:cuda
# Host directory mounted as /models in the container.
MODELS_HOST_DIR=./models
# One subdirectory per model inside /models.
MODEL_DIR=Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced
MODEL_FILE=Gemma4-26B-A4B-Uncensored-HauhauCS-Balanced-IQ4_XS.gguf

# Multimodal projection (mmproj), same directory as the model.
MMPROJ_FILE=mmproj-Gemma4-26B-A4B-Uncensored-HauhauCS-Balanced-f16.gguf
