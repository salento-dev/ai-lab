# llama-cpp-bonsai image published by the owner on Docker Hub
# (originally the private image llama-cpp-bonsai:cuda).
IMAGE=emanuelepaiano/llama-cpp-bonsai2:cuda
# Host directory mounted as /models in the container.
MODELS_HOST_DIR=./models
# Fixed subdirectory carried over from the original stack.
MODEL_DIR=prism-ml/Ternary-Bonsai-2-27B-gguf
MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# Multimodal projection (mmproj), same directory as the model.
MMPROJ_FILE=Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf
