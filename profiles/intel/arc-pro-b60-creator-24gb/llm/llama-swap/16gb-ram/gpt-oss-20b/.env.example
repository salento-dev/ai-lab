# llama-swap image bundling llama.cpp built for Intel Arc (SYCL / Level Zero).
IMAGE=ghcr.io/mostlygeek/llama-swap:intel
# Host directory mounted as /models in the container
# (original: /home/lele/docker/intel-llama-swap/models).
MODELS_HOST_DIR=./models
# One subdirectory per model inside /models.
MODEL_DIR=gpt-oss-20b
MODEL_FILE=gpt-oss-20b-Q4_K_M.gguf
